<% if (pagination == 2){ %> 
  <% 
    // 获取当前分页的文章
    var pagePosts = page.posts.toArray();

    // 仅在第一页时添加置顶文章
    if (page.current == 1) {
      // 获取全局置顶文章
      var topPosts = site.posts.toArray().filter(post => post.top).sort((a, b) => b.top - a.top);

      // 获取当前页的非置顶文章，并按时间降序排序
      var normalPosts = pagePosts.filter(post => !post.top).sort((a, b) => b.date - a.date);

      // 合并数据（第一页有置顶，其他页只有正常文章）
      var posts = topPosts.concat(normalPosts);
    } else {
      var posts = pagePosts.sort((a, b) => b.date - a.date);
    }
  %> 

  <% posts.forEach(function(post) { %> 
    <%- partial('article', {post: post, index: true}) %> 
  <% }) %> 

  <% if (page.total > 1){ %> 
    <nav id="page-nav"> 
      <%- paginator({ 
        prev_text: '&laquo; Prev', 
        next_text: 'Next &raquo;' 
      }) %> 
    </nav> 
  <% } %> 

<% } else { %> 
  <div class="archives-wrap">
    <div class="archives">
      <% 
        // 归档页按时间排序，保持分页
        var pagePosts = page.posts.toArray();

        // 仅第一页显示置顶文章
        if (page.current == 1) {
          var topPosts = site.posts.toArray().filter(post => post.top).sort((a, b) => b.top - a.top);
          var normalPosts = pagePosts.filter(post => !post.top).sort((a, b) => b.date - a.date);
          var posts = topPosts.concat(normalPosts);
        } else {
          var posts = pagePosts.sort((a, b) => b.date - a.date);
        }
      %> 

      <% posts.forEach(function(post, i) { %> 
        <%- partial('archive-post', {post: post, even: i % 2 == 0}) %> 
      <% }) %> 
    </div>
  </div>

  <% if (page.total > 1){ %> 
    <nav id="page-nav"> 
      <%- paginator({ 
        prev_text: '&laquo; Prev', 
        next_text: 'Next &raquo;' 
      }) %> 
    </nav> 
  <% } %> 
<% } %> 

